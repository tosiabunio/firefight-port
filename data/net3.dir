area net
area 0g
  source = -flics\net\0g.flc           ;gora do drzwi od zlodzieja
  lores  = net\sprites\0g.spl
  hires  = net\sprites\0g.sph
endarea

area 0d
  source = -flics\net\0d.flc           ;dol do drzwi od zlodzieja
  lores  = net\sprites\0d.spl
  hires  = net\sprites\0d.sph
endarea

area 0gd
  source = -flics\net\0gd.flc           ;gora do drzwi od zlodzieja dest
  lores  = net\sprites\0gd.spl
  hires  = net\sprites\0gd.sph
  collis = net\sprites\0gd.spc
endarea

area 0dd
  source = -flics\net\0dd.flc           ;dol do drzwi od zlodzieja dest
  lores  = net\sprites\0dd.spl
  hires  = net\sprites\0dd.sph
  collis = net\sprites\0dd.spc
endarea

area 0gdx
  source = -flics\net\0gdx.flc           ;gora do drzwi od zlodzieja good
