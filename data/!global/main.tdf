buildspritesmode=0      ;------------------------> usunac !
DEBUG=1                 ;tryb debuggingu
SX=320                  ;rozmiar ekranu
SY=200                  ;rozmiar ekranu
BACKGROUND=1            ;czy wyswietlac background
DEBUGKEYS=1             ;czy wlaczone klawisze do debugowania (przelatywanie przez sciany itp, itd)
AUTOFLYMODE=0           ;samolatanie statku
NETDEBUGLEVEL=200       ;liczba zapamietanych pakietow Bolca (0-wylaczony)
RANDDEBUGLEVEL=200      ;liczba zapamietywanych randow (0-wylaczony)
SHIPDEBUGLEVEL=1000     ;liczba zapamietywanych parametrow statku (0-wylaczony)
MEMORYDEBUG=0           ;czy debugowac uycie pamieci
SYNCFAIL=0              ;czy ma sie wydupczac samo w sieci synchronizacja
SYNCFAILABORT=1         ;czy ma sie wydupczac po zlapaniu sync failure
DISPLAYFPS=1            ;czy wyswietalc liczbe klatek na sekunde
OVERSCANX=150           ;ile pikseli w x za ekranem sa widoczne obiekty - UWAGA musi byc parzyste !!!
OVERSCANY=100           ;ile pikseli w y za ekranem sa widoczne obiekty - UWAGA musi byc parzyste !!!
METRONQUALITY=1000      ;dokladnosc metronomu (nie wiecej niz 1000)
COLISQUEUESIZE=200      ;standardowy rozmiar kolejki do kolizji dla poszczegolnych obiektow
KILLQUEUESIZE=200       ;wielkosc kolejki globalnej dla kolizji
VYTOVXRATIO=0.58        ;stosunek vy/vx
TURNSPEED=0.7           ;defaultowa liczba obrotow na sekunde
TURNQUALITY=256         ;liczba skwantowanych stopni swobody obracajacych sie obiektow
MAXOFFSET=25            ;maksymalny rozmiar tablicy szybkich offsetow
DIRNUM=32               ;defaultowa liczba kierunkow
CLIMBSPEED=70           ;defaultowa predkosc wznoszenia/opadania [pixel/sek]
PIXELSBETWEENPLANES=35  ;liczba pikseli (wysokosc) pomiedzy dwoma planami
SHADOWDIST=4            ;liczba pikseli pomiedzy cieniem a dolnym obiektem
LINKPRECISION=4         ;defaultowa dokladnosc przy osiaganiu kolejnych pozycji linka
BEYONDTIME=3            ;czas zycia obiektow poza swiatem
TARGETRAY=40            ;promien kola radaru dla celow
SYNCFRAME=50            ;wspolczynnik przez jaki dzielimy globalny counter
TIMEDELAY=80            ;wspolczynnik przez jaki mnozymy  (aux1::2) daje czas stnia w tikach po wykonaniu akcji
FRAMEDELAY=40           ;wspolczynnik przez jaki mnozymy  (aux1::1) daje czas po jakim zmieniana jest klatka (80)
LOWVOICE=50             ;procent glosnosci przg gadanych textach
RADARALIENRAY=30        ;promien kola radaru dla statkow wroga
RADARDISTANCE=800       ;zas©g radaru
