;----------------------------------------  DESTROY

area destroy_1 ;- plonaca palma
        type          = obj_destroy1
        life          = LOW_SHIELDS
        ch_sprite     = palma_z
        morph         = 1
        range         = 100
        frame_delay   = 0.05
        explode_sample= tree_burning_1
endarea

area destroy_2 ; - sam ogien - wybucha krzaczek
        type         = obj_destroy2
        life         = LOW_SHIELDS
        morph        = 1
        ch_sprite    = firez
        range        = 60
        frame_delay  = 0.05
        explode_sample= tree_burning_1
endarea

area destroy_3 ; - srodek zmieniajacy sie w krater
        type         = obj_destroy3
