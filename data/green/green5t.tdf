;----------------------------------------  DESTROY

area destroy_1 ;- plonaca palma
        type          = obj_destroy1
        life          = low_shields
        morph         = 1
        ch_sprite     = palma_z
        range         = 100
        frame_delay   = 0.04                 ;---- 0,05
        explode_sample= tree_burning_1
endarea

area destroy_2 ; - sam ogien - wybucha krzaczek
        type         = obj_destroy2
        life         = low_shields
        morph         = 1
        ch_sprite    = firez
        range        = 60
        frame_delay  = 0.04                   ;---- 0,05
        explode_sample= tree_burning_2
endarea

area destroy_3 ; - srodek zmieniajacy sie w krater
        type         = obj_destroy3
        action       = enable_after
        life         = low_shields
        morph         = 1
        explode      = 1
        ch_sprite    = ruiny1z
        range        = 60
        frame_delay  = 0.04
endarea

area destroy_4 ; - do wysokiego domku, rozdupczona gora
        type         = obj_destroy4
        life         = medium_shields
        explode      = 1
        ch_sprite    = ruiny2gz
        range        = 60
        frame_delay  = 0.04
endarea

area destroy_5 ; - plonace beczki
        type         = obj_destroy5
        life         = low_shields
        explode      = 1
        ch_sprite    = beczki_z
        range        = 60
        frame_delay  = 0.04                  ;----- 0,03
endarea


