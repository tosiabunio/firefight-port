;---------------------------------------- DRZWI

 area green_door
        type           = doorgreen
        delay          = 60
        open           = 0
endarea

area green_switch
        type           = switchgreen
        standtime      = 60
        door_type      = green_door
endarea

area yellow_door
        type           = dooryellow
        delay          = 60
        open           = 0
endarea

area yellow_switch
        type           = switchyellow
        standtime      = 60
