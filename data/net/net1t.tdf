        frame_delay   = 0.07
        visible       = 0
endarea

 area  medium_flame
        type          = obj_destroy11
        life          = LOW_SHIELDS
        explode       = 1
        ch_sprite     = m_flame
        range         = 60
        frame_delay   = 0.07
        visible       = 0
 endarea

 area  small_flame
        type          = obj_destroy12
        life          = LOW_SHIELDS
        explode       = 1
        ch_sprite     = s_flame
        range         = 60
        frame_delay   = 0.07
        visible       = 0
 endarea





