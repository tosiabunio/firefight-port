       "ludek1"
       "ludek2"

    area ludek1
       type         "obj_collectLUDEK1"
       count        = 1
       displ_text
       "brown_2_A_1" "brown_2_A_1" "STACY"
       "brown_2_A_2" "brown_2_A_2" "STACY"
       "brown_2_A_3" "brown_2_A_3" "STACY"
       "brown_2_A_4" "brown_2_A_4" "STACY"
    endarea

