# Sprite build caches the original engine wrote next to the data (hires .sph, collision .spc,
# palette tables .spp, lores .spl). The port builds sprites in memory and never writes them.
*.sph
*.spc
*.spp
*.spl

# Runtime logs written by the engine and game
lastexec.log
firefght.log
Firefght.log

# Build output and local tool state
/build/
/out/
/vcpkg_installed/
/.vs/
/.vscode/
CMakeUserPresets.json

# Python bytecode from tools/
__pycache__/
